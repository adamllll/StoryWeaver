# 织梦者 (StoryWeaver) - 后端环境变量配置
# 将此文件复制为 .env 并填入你的配置值

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL=sqlite:///./data/story.db

# ===========================================
# JWT 认证配置
# ===========================================
# 重要：生产环境中请务必更改为安全的随机字符串！
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ===========================================
# AI 服务 - OpenAI 兼容接口
# ===========================================
# 你的 OpenAI API 密钥或兼容服务的密钥
OPENAI_API_KEY=sk-your-api-key-here

# API 基础地址（使用 OpenAI 兼容服务时需修改）
OPENAI_BASE_URL=https://api.openai.com/v1

# -------------------------------------------
# 分功能模型配置（留空则使用默认模型）
# -------------------------------------------
# 默认模型（作为其他未配置功能的后备）
OPENAI_MODEL=gpt-4

# 大纲生成模型（需要强逻辑能力）
OPENAI_MODEL_OUTLINE=gpt-4

# 章节续写模型（需要创意和长上下文）
OPENAI_MODEL_CONTINUE=gpt-4

# 文本扩写模型（相对简单，可用便宜模型节省成本）
OPENAI_MODEL_EXPAND=gpt-3.5-turbo

# 文本重写模型（需要更强的遵循能力）
OPENAI_MODEL_REWRITE=gpt-4

# 角色生成模型（需要创意）
OPENAI_MODEL_CHARACTER=gpt-4

# 分支生成模型（需要理解剧情走向）
OPENAI_MODEL_BRANCH=gpt-4

# ===========================================
# AI 服务 - Claude（可选）
# ===========================================
CLAUDE_API_KEY=sk-ant-your-claude-key-here
CLAUDE_MODEL=claude-3-opus-20240229

# ===========================================
# 服务器配置
# ===========================================
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ===========================================
# 速率限制
# ===========================================
AI_REQUESTS_PER_MINUTE=5

# ===========================================
# 默认管理员配置 (init_db 自动创建)
# ===========================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
